    // ---------- VersionDownloads ----------
    inline void to_json(json &j, const VersionDownloads &obj)
    {
        j = json::object();
        j["client"] = obj.client;
        SERIALIZE_OPTIONAL_TO_JSON(server);
        SERIALIZE_OPTIONAL_TO_JSON(windows_server);
    }

