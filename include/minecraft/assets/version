    }

    // ---------- VersionManifest ----------
    inline void to_json(json &j, const VersionManifest &obj)
    {
        j = json::object();
        j["id"] = obj.id;
        j["type"] = obj.type;
        j["mainClass"] = obj.mainClass;
        j["releaseTime"] = obj.releaseTime;
        j["time"] = obj.time;
        j["minimumLauncherVersion"] = obj.minimumLauncherVersion;
        SERIALIZE_OPTIONAL_TO_JSON(complianceLevel);
        j["assetIndex"] = obj.assetIndex;
        j["assets"] = obj.assets;
        j["downloads"] = obj.downloads;
        j["javaVersion"] = obj.javaVersion;
        j["libraries"] = obj.libraries;
        SERIALIZE_OPTIONAL_TO_JSON(arguments);
        SERIALIZE_OPTIONAL_TO_JSON(minecraftArguments);
        SERIALIZE_OPTIONAL_TO_JSON(logging);
    }

    inline void from_json(const json &j, VersionManifest &obj)
    {
        j.at("id").get_to(obj.id);
        j.at("type").get_to(obj.type);
        j.at("mainClass").get_to(obj.mainClass);
        j.at("releaseTime").get_to(obj.releaseTime);
        j.at("time").get_to(obj.time);
        j.at("minimumLauncherVersion").get_to(obj.minimumLauncherVersion);
        DESERIALIZE_OPTIONAL_FROM_JSON(complianceLevel);
        j.at("assetIndex").get_to(obj.assetIndex);
        j.at("assets").get_to(obj.assets);
        j.at("downloads").get_to(obj.downloads);
        j.at("javaVersion").get_to(obj.javaVersion);
        j.at("libraries").get_to(obj.libraries);
        DESERIALIZE_OPTIONAL_FROM_JSON(arguments);
        DESERIALIZE_OPTIONAL_FROM_JSON(minecraftArguments);
        DESERIALIZE_OPTIONAL_FROM_JSON(logging);
    }

#undef SERIALIZE_OPTIONAL_TO_JSON
#undef DESERIALIZE_OPTIONAL_FROM_JSON

